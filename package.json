{
  "name": "streamoid",
  "version": "1.0.0",
  "description": "Streamoid Backend Task",
  "main": "server.js",
  "author": "Divyansh Seth",
  "license": "ISC",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx knex migrate:latest --knexfile ./knexfile.js",
    "rollback": "npx knex migrate:rollback --knexfile ./knexfile.js",
    "seed": "npx knex seed:run --knexfile ./knexfile.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "knex": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
