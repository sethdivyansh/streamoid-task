{
  "name": "streamoid",
  "version": "1.0.0",
  "description": "Streamoid Backend Task",
  "main": "server.js",
  "author": "Divyansh Seth",
  "license": "ISC",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx knex migrate:latest --knexfile ./knexfile.js",
    "rollback": "npx knex migrate:rollback --knexfile ./knexfile.js",
    "seed": "npx knex seed:run --knexfile ./knexfile.js",
        "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validator": "jest test/csvValidator.test.js",
    "test:parsing": "jest test/csvParsing.test.js", 
    "test:filters": "jest test/searchFilters.test.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "knex": "^2.5.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.1.4"
  }
}
